{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwdata.local/schemas/catalog.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "notation_md": {
      "type": "string",
      "minLength": 1
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "https://cwdata.local/schemas/common.schema.json#/$defs/chapter"
      },
      "minItems": 1
    },
    "credits_md": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "title",
    "language",
    "updated",
    "notation_md",
    "chapters"
  ],
  "additionalProperties": false
}
